<Window x:Class="WPF_Proj1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Proj1"
        xmlns:UserControls="clr-namespace:WPF_Proj1.View.UserControls"
        mc:Ignorable="d"
        Title="PixaF0rk" Height="720" Width="1280">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#000" Padding="10">
            <TextBlock Text="Welcome to PixaF0rk!" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF9F43" FontFamily="Consolas"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <UserControls:Register Grid.Row="1" Grid.Column="0" />
            <UserControls:Login Grid.Row="1" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
