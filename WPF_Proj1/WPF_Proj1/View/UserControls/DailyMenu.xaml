<UserControl x:Class="WPF_Proj1.View.UserControls.DailyMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Proj1.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="526" d:DesignWidth="974">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Background="BlueViolet">
            <TextBlock Text="Daily Menu" Height="70" Margin="0,0,0,430" FontSize="40" FontWeight="DemiBold" FontFamily="Modern No. 20" Background="Transparent" HorizontalAlignment="Center"/>
            <Grid Height="5" Margin="0 0 0 400" Background="Black" Width="200"></Grid>
            <TextBlock Text="Today's date: {Binding TodayDate}" Height="80" Margin="0 0 0 300" Width="300" FontSize="25"/>
            <TextBlock Text="Fish soup" Height="30" Margin="0,0,0,190" FontSize="25" HorizontalAlignment="Center"/>
            <CheckBox Content="Soup" Height="25" Margin="0 0 0 140" HorizontalAlignment="Center" FontSize="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <TextBlock Text="A: {Binding A}" Height="30" Margin="0,0,0,50" HorizontalAlignment="Center" FontSize="25"/>
            <TextBlock Text="B: {Binding A}" Height="30" Margin="0 0 0 -50" HorizontalAlignment="Center" FontSize="25"/>
            <Grid VerticalAlignment="Center">
                <RadioButton Content="A" Height="20" Margin="0 0 0 -110" HorizontalAlignment="Center"/>
                <RadioButton Content="B" Height="20" Margin="0 0 0 -130" HorizontalAlignment="Center"/>
            </Grid>
            <TextBlock Text="Price: " Height="40" Margin="0 0 0 -200" HorizontalAlignment="Center" FontSize="32"/>
        </Grid>
    </Grid>
</UserControl>
