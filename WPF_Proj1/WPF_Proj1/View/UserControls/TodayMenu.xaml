<UserControl x:Class="WPF_Proj1.View.UserControls.TodayMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Proj1.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="546" d:DesignWidth="972">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Background="BlueViolet">
            <TextBlock Text="Daily Menu" Height="70" Margin="0,0,0,430" FontSize="40" FontWeight="DemiBold" FontFamily="Modern No. 20" Background="Transparent" HorizontalAlignment="Center"/>
            <Grid Height="5" Margin="0 0 0 400" Background="Black" Width="200"></Grid>
            <TextBlock x:Name="tDate" Height="80" Margin="0 0 0 300" Width="300" FontSize="25"/>
            <TextBlock x:Name="Soup" Height="30" Margin="0,0,0,190" FontSize="25" HorizontalAlignment="Center"/>
            <CheckBox x:Name="SoupCb" Height="25" Margin="0 0 0 140" HorizontalAlignment="Center" FontSize="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <TextBlock x:Name="DishA" Height="30" Margin="0,0,0,50" HorizontalAlignment="Center" FontSize="25"/>
            <TextBlock x:Name="DishB" Height="30" Margin="0 0 0 -50" HorizontalAlignment="Center" FontSize="25"/>
            <RadioButton x:Name="NoneC" Content="None" IsChecked="True" Height="20" Margin="0 0 200 -110" HorizontalAlignment="Center"/>
            <RadioButton x:Name="AC" Content="Option A" Height="20" Margin="0 0 0 -110" HorizontalAlignment="Center"/>
            <RadioButton x:Name="BC" Content="Option B" Height="20" Margin="0 0 -200 -110" HorizontalAlignment="Center"/>
            <TextBlock x:Name="price" Height="40" Margin="0 0 0 -200" HorizontalAlignment="Center" FontSize="32"/>
            <Button Height="40" Margin="0 0 0 -350" Width="160" Content="Save changes" FontSize="25" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#800080" Foreground="#00ADB5" BorderThickness="1" BorderBrush="#4A354A" Click="SaveDailyMenu"/>
        </Grid>
    </Grid>

</UserControl>
