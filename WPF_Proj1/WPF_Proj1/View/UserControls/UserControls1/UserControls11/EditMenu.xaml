<UserControl x:Class="WPF_Proj1.View.UserControls.UserControls1.UserControls11.EditMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Proj1.View.UserControls.UserControls1.UserControls11"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border BorderThickness="3" BorderBrush="Cyan" CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="95*"/>
                </Grid.RowDefinitions>

                <Border Background="#800080" CornerRadius="20 20 0 0" BorderThickness="0 0 0 2" BorderBrush="#808080">
                    <Grid>
                        <Border CornerRadius="30">
                            <Button Content="X" Width="20"/>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
