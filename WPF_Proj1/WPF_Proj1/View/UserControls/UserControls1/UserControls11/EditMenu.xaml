<UserControl x:Class="WPF_Proj1.View.UserControls.UserControls1.UserControls11.EditMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Proj1.View.UserControls.UserControls1.UserControls11"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border BorderThickness="3" BorderBrush="Cyan" CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="95*"/>
                </Grid.RowDefinitions>

                <Border Background="#800080" CornerRadius="20 20 0 0" BorderThickness="0 0 0 2" BorderBrush="#808080" Panel.ZIndex="2">
                    <Grid>
                        <Border CornerRadius="30">
                            <Grid>
                                <Button Content="X" Width="20" Margin="750 0 0 0" Foreground="red" Background="Transparent" FontWeight="bold" BorderBrush="Transparent" FontSize="16" VerticalAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Padding="0,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Background="MediumPurple" Grid.Row="1" CornerRadius="0 0 20 20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Soup" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="40"/>
                            <TextBox Grid.Row="1" Width="400" Height="50"/>
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="40" Text="Dish A"/>
                            <TextBox Grid.Row="3" Width="400" Height="50"/>
                            <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="40" Text="Dish B"/>
                            <TextBox Grid.Row="5" Width="400" Height="50"/>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Border Width="50" Height="30" Background="LimeGreen" CornerRadius="15">
                                <Button Content="Save" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="18" Background="Transparent" BorderBrush="Transparent" Click="SaveChanges" Margin="0,0,0,1"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
