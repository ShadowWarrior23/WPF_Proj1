<UserControl x:Class="WPF_Proj1.View.UserControls.UserControls1.DayInMonth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Proj1.View.UserControls.UserControls1"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    <Border Background="#4A354A" BorderBrush="#800080" BorderThickness="1">
        <Grid VerticalAlignment="Center">
            <Grid Grid.Row="1">
                <TextBlock x:Name="tDay"/>
                <TextBlock Text="Example soup" Margin="0 0 500 0" Width="100" />
                <CheckBox Margin="0 0 200 0" Width="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ComboBox Width="300" SelectedIndex="0" Margin="300 0 0 0" Background="BlueViolet">
                    <ComboBoxItem Content="None" Background="BlueViolet"/>
                    <ComboBoxItem Content="A: Chicken risotto with mushroom stew" Background="BlueViolet"/>
                    <ComboBoxItem Content="B: Steak with steamed potato" Background="BlueViolet"/>
                </ComboBox>
            </Grid>
            

        </Grid>
    </Border>
</UserControl>
