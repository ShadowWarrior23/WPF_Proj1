<UserControl x:Class="WPF_Proj1.View.UserControls.UserControls1.DayInMonthAdmin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UserControls="clr-namespace:WPF_Proj1.View.UserControls.UserControls1.UserControls11"
             xmlns:local="clr-namespace:WPF_Proj1.View.UserControls.UserControls1"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    <Grid>
        <Border Background="#4A354A" BorderBrush="#800080" BorderThickness="1">
            <Grid VerticalAlignment="Center">
                <Grid Grid.Row="1">
                    <TextBlock x:Name="tDay"/>
                    <TextBlock Text="Example soup" Margin="0 0 500 0" Width="100" VerticalAlignment="Center"/>
                    <Grid Margin="300 0 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="A: Chicken risotto with mushroom stew"/>
                        <TextBlock Grid.Row="1" Text="B: Steak with steamed potato"/>
                    </Grid>
                    <Button Width="50" Margin="600 0 0 0" BorderThickness="2" BorderBrush="#800080" Background="#FF9F43" Content="Edit" Click="Popup" x:Name="EditBtn"/>
                </Grid>


            </Grid>
        </Border>
    </Grid>
</UserControl>
