<UserControl x:Class="WPF_Proj1.View.UserControls.UserControls1.Profile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Proj1.View.UserControls.UserControls1"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="300">
    <Grid>
        <Border Background="#251825" Opacity="0.7" BorderThickness="1" BorderBrush="#800080">
            <Grid>
                <TextBlock x:Name="Username" Width="200" Height="30" Margin="0 0 0 100" Foreground="#00ADB5"/>
                <TextBlock x:Name="FullName" Width="200" Height="30" Margin="0 0 0 50" Foreground="#E2E8F0"/>
                <TextBlock x:Name="Password" Width="200" Height="30" Margin="0 0 0 0" Foreground="#6E5A6E"/>
                <Grid>
                    <Button Width="75" Height="30" Margin="200 100 0 0" Content="Remove" FontSize="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#D48166" Background="#2D1212" Click="RemUser"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
