<UserControl x:Class="WPF_Proj1.View.UserControls.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Proj1.View.UserControls"
             xmlns:UserControls1="clr-namespace:WPF_Proj1.View.UserControls.UserControls1"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid Background="#16213E">
            <TextBlock Text="LOGIN" Height="50" Width="90" VerticalAlignment="Center" Margin="0 0 0 200" FontWeight="Bold" Foreground="#00ADB5" FontSize="30"/>
            <UserControls1:ClearableTextboxDark2 x:Name="UserName" Width="250" Height="40" Margin="0 0 0 100" Placeholder="Username"/>
            <UserControls1:ClearableTextboxDark2 x:Name="Password" Width="250" Height="40" Margin="0 0 0 0" Placeholder="Password"/>
            <Button Content="Login" Width="300" Margin="0 0 0 -150" VerticalAlignment="Center" Background="#00ADB5" Foreground="#0A192F" Padding="5" FontSize="20" BorderBrush="#6610F2" BorderThickness="2" Click="Button_Click"/>
        </Grid>
    </Grid>
</UserControl>
